// Value Scope. Runs after Tonemap, so values are display encoded (0..1 = 0..255),
// the same scale a Photoshop histogram reads.

#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

SCREEN_PASS_TEXTURE_VIEWPORT(Input)
SCREEN_PASS_TEXTURE_VIEWPORT(Output)

Texture2D InputTexture;
SamplerState InputSampler;

int Mode;               // 0 off, 1 plumbing check, 2 notan, 3 false color
float2 NotanThresholds; // x = shadow max, y = highlight min
float2 ClipLevels;      // x = black clip, y = white clip
int ClipZebras;
int ThirdsGuide;

// Photoshop Luminosity histogram weights. Keep in sync with Tools/value_report.py.
float Luma(float3 C)
{
	return dot(C, float3(0.30, 0.59, 0.11));
}

// Luma as a whole level 0 to 255, from the 8-bit color a PNG and Photoshop see.
// 30R + 59G + 11B is luma * 255 * 100 exactly (the weights above), so no float rounding
// at .5 ties. The histogram, the zebras and value_report.py all use this.
uint LumaLevel(float3 C)
{
	const uint3 Q = (uint3)round(saturate(C) * 255.0);
	return min(255u, (30u * Q.r + 59u * Q.g + 11u * Q.b + 50u) / 100u);
}

// Zone 0 to X. Keep in sync with ZONE_PALETTE in Tools/value_report.py.
static const float3 ZonePalette[11] =
{
	float3(0.25, 0.00, 0.40), // 0
	float3(0.10, 0.10, 0.65), // I
	float3(0.00, 0.35, 0.80), // II
	float3(0.00, 0.55, 0.55), // III
	float3(0.15, 0.60, 0.20), // IV
	float3(0.50, 0.50, 0.50), // V
	float3(0.70, 0.70, 0.30), // VI
	float3(0.95, 0.80, 0.10), // VII
	float3(1.00, 0.55, 0.00), // VIII
	float3(1.00, 0.30, 0.30), // IX
	float3(1.00, 0.00, 0.00), // X
};

#ifndef THREADGROUP_SIZE
#define THREADGROUP_SIZE 16
#endif

RWBuffer<uint> HistogramOut;
groupshared uint LocalBins[THREADGROUP_SIZE * THREADGROUP_SIZE];

// Luma histogram, 256 bins. Binning must match value_report.py --histogram-csv:
// quantize to 8 bits (what a PNG and Photoshop see), then bin = round(luma * 255) in whole
// numbers: 30R + 59G + 11B is luma * 255 * 100 exactly (the 0.30 / 0.59 / 0.11 weights),
// so there is no float rounding to disagree on at the .5 ties.
[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void HistogramCS(uint3 DispatchThreadId : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
{
	LocalBins[GroupIndex] = 0;
	GroupMemoryBarrierWithGroupSync();

	if (all(DispatchThreadId.xy < uint2(Input_ViewportSize)))
	{
		const int2 Pixel = int2(Input_ViewportMin) + int2(DispatchThreadId.xy);
		const uint Bin = LumaLevel(InputTexture.Load(int3(Pixel, 0)).rgb);
		InterlockedAdd(LocalBins[Bin], 1u);
	}
	GroupMemoryBarrierWithGroupSync();

	// One thread per bin merges this group's counts into the frame total.
	if (LocalBins[GroupIndex] > 0)
	{
		InterlockedAdd(HistogramOut[GroupIndex], LocalBins[GroupIndex]);
	}
}

Buffer<uint> HistogramIn;
Buffer<uint> HistogramMax;
RWBuffer<uint> HistogramMaxOut;
groupshared uint SharedMax;

// Tallest bin in levels 1 to 254. 0 and 255 are left out so a clipped spike can't
// flatten the rest; the panel marks them separately.
[numthreads(256, 1, 1)]
void HistogramMaxCS(uint GroupIndex : SV_GroupIndex)
{
	if (GroupIndex == 0)
	{
		SharedMax = 0;
	}
	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex >= 1 && GroupIndex <= 254)
	{
		InterlockedMax(SharedMax, HistogramIn[GroupIndex]);
	}
	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex == 0)
	{
		HistogramMaxOut[0] = SharedMax;
	}
}

#ifndef VALUE_SCOPE_HISTOGRAM
#define VALUE_SCOPE_HISTOGRAM 0
#endif

float4 HistogramRect; // panel min x, min y, width, height, in view pixels

void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	const float2 PixelPos = SvPosition.xy - Output_ViewportMin;
	float2 UV = PixelPos * Output_ViewportSizeInverse;
	UV = Input_UVViewportMin + UV * Input_UVViewportSize;

	const float4 Src = Texture2DSample(InputTexture, InputSampler, UV);
	const float L = saturate(Luma(Src.rgb));
	float3 Result = Src.rgb;

	if (Mode == 2)
	{
		Result = L < NotanThresholds.x ? 0.0 : (L > NotanThresholds.y ? 1.0 : 0.5);
	}
	else if (Mode == 3)
	{
		const int Zone = clamp((int)floor(L * 10.999), 0, 10);
		Result = ZonePalette[Zone];
	}

	// Sizes scale with the view so they read the same at any resolution.
	const float Scale = max(1.0, round(Output_ViewportSize.y / 540.0));

	if (ClipZebras != 0)
	{
		// Diagonal stripes over clipped pixels, tested on the source image in whole levels,
		// so they mark exactly the pixels the clip percentages count, whatever the mode.
		const float Period = 6.0 * Scale;
		const bool bStripe = frac((PixelPos.x + PixelPos.y) / Period) < 0.5;
		const uint Level = LumaLevel(Src.rgb);
		if (bStripe && Level >= (uint)round(ClipLevels.y * 255.0))
		{
			Result = float3(1.0, 0.0, 0.0);
		}
		else if (bStripe && Level <= (uint)round(ClipLevels.x * 255.0))
		{
			Result = float3(0.0, 0.4, 1.0);
		}
	}

	if (ThirdsGuide != 0)
	{
		const float2 Third = Output_ViewportSize / 3.0;
		const float2 D = min(abs(PixelPos - Third), abs(PixelPos - 2.0 * Third));
		if (min(D.x, D.y) < 0.5 * Scale)
		{
			// Dark line on bright areas, light line on dark areas, so it always shows.
			const float Line = Luma(Result) > 0.6 ? 0.0 : 1.0;
			Result = lerp(Result, Line, 0.7);
		}
	}

#if VALUE_SCOPE_HISTOGRAM
	{
		// Histogram panel, drawn over everything else. Levels run left to right, 0 to 255.
		const float2 P = (PixelPos - HistogramRect.xy) / HistogramRect.zw;
		if (all(P >= 0.0) && all(P < 1.0))
		{
			Result *= 0.3; // Dim backing, so bars read over any image.

			// Faint guides at levels 64, 128 and 192.
			const float Quarter = P.x * 4.0;
			if (abs(Quarter - round(Quarter)) * HistogramRect.z * 0.25 < 0.5 * Scale && Quarter > 0.5 && Quarter < 3.5)
			{
				Result = lerp(Result, 0.5, 0.35);
			}

			const uint Level = min(255u, (uint)(P.x * 256.0));
			const uint Count = HistogramIn[Level];
			const float Tallest = max(1.0, (float)HistogramMax[0]);
			const float Up = 1.0 - P.y; // 0 at the bottom edge
			if (Up < saturate(Count / Tallest))
			{
				// Clipped levels in the zebra colors.
				Result = Level == 0 ? float3(0.0, 0.4, 1.0) : (Level == 255 ? float3(1.0, 0.0, 0.0) : float3(0.85, 0.85, 0.85));
			}

			// Edge strips whenever anything is clipped, since a 1-level bar is thin.
			const float Strip = 3.0 * Scale / HistogramRect.z;
			if (P.x < Strip && HistogramIn[0] > 0)
			{
				Result = float3(0.0, 0.4, 1.0);
			}
			else if (P.x > 1.0 - Strip && HistogramIn[255] > 0)
			{
				Result = float3(1.0, 0.0, 0.0);
			}
		}
	}
#endif

	if (Mode == 1)
	{
		// Plumbing check: image passes through untouched, with a magenta frame
		// exactly on the view rect edges. A clipped or offset frame means the
		// viewport mapping is wrong.
		const float2 FromEdge = min(PixelPos, Output_ViewportSize - PixelPos);
		if (min(FromEdge.x, FromEdge.y) < 6.0)
		{
			Result = float3(1.0, 0.0, 1.0);
		}
	}

	OutColor = float4(Result, Src.a);
}
